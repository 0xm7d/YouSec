# YouSec Cybersecurity Club — Environment Variables Configuration

# 1. Email Notification Service (EmailJS)
# Create a free account & template at https://emailjs.com
VITE_EMAILJS_SERVICE_ID=service_yousec
VITE_EMAILJS_TEMPLATE_ID=template_yousec_app
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# 2. Staff Email Destination
VITE_ADMIN_EMAIL=your-staff-email@example.com

# 3. Optional: Custom Webhook Endpoint (e.g. Discord bot / Formspree / Webhook relay)
# VITE_APPLICATION_WEBHOOK_URL=https://formspree.io/f/your_form_id
