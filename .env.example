# YouSec Cybersecurity Club — Environment Variables Configuration

# 1. Supabase (Database Backend)
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Email Notification (Admin destination: mohamedbriti01@gmail.com)
# Create a free service and template at https://emailjs.com
VITE_EMAILJS_SERVICE_ID=service_yousec
VITE_EMAILJS_TEMPLATE_ID=template_yousec_app
VITE_EMAILJS_PUBLIC_KEY=your_public_key

